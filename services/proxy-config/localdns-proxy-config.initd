#!/sbin/openrc-run
name="localdns-proxy-config"
description="LocalDNS proxy configuration editor"
supervisor=supervise-daemon
command="/opt/localdns-proxy-config/bin/localdns-proxy-config"
command_args="--config /etc/localdns-proxy-config.json"
directory="/opt/localdns-proxy-config"
output_log="/var/log/localdns-proxy-config.log"
error_log="/var/log/localdns-proxy-config.log"
respawn_delay=5
respawn_max=5
retry="TERM/120/KILL/5"
export GOMEMLIMIT=24MiB
export GOGC=50
depend() {
    need net
}
