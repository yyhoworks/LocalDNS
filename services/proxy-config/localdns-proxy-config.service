[Unit]
Description=LocalDNS local proxy configuration editor
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/localdns-proxy-config
ExecStart=/opt/localdns-proxy-config/bin/localdns-proxy-config --config /etc/localdns-proxy-config.json
Environment=GOMEMLIMIT=24MiB
Environment=GOGC=50
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
