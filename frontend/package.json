{
  "name": "localdns-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "verify:generated": "node scripts/verify-build.mjs",
    "check:fonts": "node scripts/check-font-subset.mjs",
    "check": "npm run build && npm run typecheck && npm run test && npm run lint && npm run verify:generated && npm run check:fonts"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "6.0.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "10.13.0",
    "globals": "17.4.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@noble/hashes": "2.4.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  }
}
